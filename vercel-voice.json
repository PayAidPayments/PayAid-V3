{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps --no-audit --no-fund --ignore-scripts && npx prisma generate --schema=packages/db/prisma/schema.prisma",
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=6144 npm run build -w voice",
  "outputDirectory": "apps/voice/.next"
}
