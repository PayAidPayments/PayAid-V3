{
  "name": "voice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.cjs",
    "dev:full": "node ../../node_modules/cross-env/dist/bin/cross-env.js PAYAID_DEV_FULL=1 node scripts/dev-server.cjs",
    "dev:turbo": "node ../../node_modules/cross-env/dist/bin/cross-env.js PAYAID_DEV_TURBOPACK=1 node scripts/dev-server.cjs",
    "prebuild": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "build": "next build --webpack",
    "start": "next start -p 3003",
    "lint": "node ../../node_modules/cross-env/dist/bin/cross-env.js ESLINT_USE_FLAT_CONFIG=true eslint ."
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@payaid/ai": "file:../../packages/ai",
    "@payaid/db": "file:../../packages/db",
    "@payaid/domain-voice": "file:../../packages/domains/voice",
    "next": "^16.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.0",
    "typescript": "^5.5.0"
  }
}
